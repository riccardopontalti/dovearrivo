{
	"name": "dovearrivo",
	"private": true,
	"version": "0.0.0",
	"description": "Car-free day trips with a guaranteed way home",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"gen:api": "openapi-typescript spec/api.openapi.yaml -o src/lib/api/types.gen.ts && node scripts/gen-schemas.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.pipeline.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest --project server",
		"test": "npm run test:unit -- --run",
		"engine:fixtures": "scripts/engine-fixtures.sh",
		"test:engine": "MOTIS_URL=${MOTIS_URL:-http://127.0.0.1:8090} vitest --run --project engine",
		"data:update": "node pipeline/run.ts",
		"data:rollback": "node pipeline/rollback.ts",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@playwright/test": "1.63.0",
		"@protomaps/basemaps": "5.7.2",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "24.13.6",
		"maplibre-gl": "6.11.2",
		"openapi-typescript": "7.13.0",
		"pmtiles": "4.5.0",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"typescript": "5.9.3",
		"vite": "8.3.1",
		"vitest": "4.1.11"
	}
}
